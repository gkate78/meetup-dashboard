# Copy to .streamlit/secrets.toml (git-ignored and excluded from the Docker image).
# On Dokploy, provide this file as a File Mount at /app/.streamlit/secrets.toml.

# Organizer emails allowed into the Admin page (MODERATOR_EMAILS env var also works).
MODERATOR_EMAILS = "organizer1@example.com, organizer2@example.com"

[auth]
# Must match an authorized redirect URI on the Google OAuth client exactly.
redirect_uri = "http://localhost:8501/oauth2callback"
# Random value that signs the login cookie: python -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = ""
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
